{
  "servers": {
    "redmine-mcp-server": {
      "type": "stdio",
      "command": "python",
      "args": [
        "src/redmine_mcp_server.py"
      ],
      "cwd": "034.redmine-mcp-server",
      "env": {
        "SESSION_TIMEOUT": "3600",
        "REQUEST_TIMEOUT": "30",
        "MAX_RETRIES": "3",
        "RETRY_DELAY": "1.0"
      }
    }
  }
}